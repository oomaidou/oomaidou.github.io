{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- /*
  自定义 sitemap，在 Hugo 默认模板基础上排除两类页面：

  1. 首页：/ 已在 Nginx 做 301 到 /coupons/，sitemap 里不该放会跳转的 URL，
     否则搜索引擎会反复抓一个只会跳转的地址。

  2. 文章数少于 3 篇的标签/分类页：站上 194 个标签里有 160 个只覆盖 1-2 篇文章，
     这种聚合页内容跟文章高度重合，Google 已经明确不收录（GSC 报 177 个
     「已发现-尚未编入索引」，与标签页数量吻合）。留在 sitemap 里只会
     稀释爬取预算——百度抓取频次才 1-3 次/天，一半以上花在这些页面上很浪费。
     这些页面同时在 extend_head.html 里输出 noindex。

  阈值改动时，两处要一起改：本文件的 $minPages 和 extend_head.html 里的同名变量。
*/ -}}
{{- $minPages := 3 -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Pages }}
  {{- $skip := false }}
  {{- if eq .Kind "home" }}{{ $skip = true }}{{ end }}
  {{- if and (eq .Kind "term") (lt (len .Pages) $minPages) }}{{ $skip = true }}{{ end }}
  {{- if not $skip }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
